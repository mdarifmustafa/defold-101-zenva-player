[bootstrap]
main_collection = /game/game_controller.collectionc
render = /builtins/render/default.renderc

[script]
shared_state = 1

[display]
width = 960
height = 640
high_dpi = 1
update_frequency = 60

[android]
input_method = HiddenInputField

[html5]
scale_mode = stretch

[project]
title = Wild Run
dependencies = 
version = 1.1

[graphics]
default_texture_min_filter = nearest
default_texture_mag_filter = nearest

[physics]
use_fixed_timestep = 1

